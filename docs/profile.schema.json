{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WGX v1 compatibility profile",
  "description": "Compatibility schema for the current WGX runner. Canonical profiles use the nested wgx block; root-level task keys remain accepted only for legacy parser compatibility.",
  "type": "object",
  "properties": {
    "wgx": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": "v1"
        },
        "requiredWgx": {
          "$ref": "#/definitions/requiredWgx"
        },
        "required-wgx": {
          "$ref": "#/definitions/requiredWgx"
        },
        "repoKind": {
          "type": "string"
        },
        "tasks": {
          "$ref": "#/definitions/tasks"
        },
        "validate": {
          "$ref": "#/definitions/validate"
        }
      },
      "additionalProperties": true
    },
    "tasks": {
      "$ref": "#/definitions/tasks"
    },
    "requiredWgx": {
      "$ref": "#/definitions/requiredWgx"
    },
    "required-wgx": {
      "$ref": "#/definitions/requiredWgx"
    },
    "repoKind": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "required": [
        "wgx"
      ],
      "properties": {
        "wgx": {
          "required": [
            "apiVersion",
            "tasks"
          ]
        }
      }
    },
    {
      "required": [
        "tasks"
      ]
    }
  ],
  "additionalProperties": true,
  "definitions": {
    "requiredWgx": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "range": {
              "type": "string"
            },
            "min": {
              "type": "string"
            },
            "caps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "command": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "task": {
      "oneOf": [
        {
          "$ref": "#/definitions/command"
        },
        {
          "type": "object",
          "properties": {
            "cmd": {
              "$ref": "#/definitions/command"
            },
            "sh": {
              "$ref": "#/definitions/command"
            },
            "desc": {
              "type": "string"
            },
            "safe": {
              "type": [
                "boolean",
                "string"
              ]
            },
            "group": {
              "type": "string"
            },
            "args": {}
          },
          "anyOf": [
            {
              "required": [
                "cmd"
              ]
            },
            {
              "required": [
                "sh"
              ]
            }
          ],
          "additionalProperties": true
        }
      ]
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/task"
      }
    },
    "taskNames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "skipReasons": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "validate": {
      "type": "object",
      "properties": {
        "quick": {
          "$ref": "#/definitions/taskNames"
        },
        "full": {
          "$ref": "#/definitions/taskNames"
        },
        "unsupported": {
          "$ref": "#/definitions/skipReasons"
        },
        "ciOnly": {
          "$ref": "#/definitions/skipReasons"
        }
      },
      "additionalProperties": false
    }
  }
}
